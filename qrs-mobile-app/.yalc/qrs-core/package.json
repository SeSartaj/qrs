{
  "name": "qrs-core",
  "version": "0.1.0",
  "description": "SDoc Verification Protocol core: offline-first, cross-organization verification of digitally signed documents (TCert / SDoc / Statement). Minimal audited runtime dependencies (@noble/hashes, @scure/base); inversion-of-control storage and context.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Sartaj Ahmad Masoud <sartaj2dev at gmail doot com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.browser.js",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.browser.d.ts",
      "import": "./dist/index.browser.js"
    },
    "./cli": {
      "types": "./dist/cli/cli.d.ts",
      "import": "./dist/cli/cli.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "qrs": "dist/cli/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "cli": "node dist/cli/cli.js",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "sdoc",
    "verification",
    "digital-signature",
    "qrcode",
    "offline-first",
    "tcert",
    "cbor",
    "cose",
    "ed25519",
    "ecdsa"
  ],
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@scure/base": "^2.3.0"
  },
  "yalcSig": "774a160fc247e4481884b405df87c57d"
}
